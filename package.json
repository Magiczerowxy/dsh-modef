{
  "name": "@magiczerowxy/dsh-modef",
  "version": "0.9.0",
  "description": "模型选择 + 推理强度滑块 + 可选提供商开关：模型保持下拉菜单，推理强度改为 Claude 风格滑块，最高档可选四种动画（喷射流光 / 暗流涌动 / 流体 / 晚霞，后两者每次打开浮层随机重掷；晚霞配色采自参考图）；设置-模型 底部多一个「可选提供商」面板，逐个启用/停用模型提供商（提供商配置原样保留）。已适配 DSH 0.1.7-rc.1 与 0.2.0-rc.1/rc.2（plugins.item / configForms / settings.models.footer）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    }
  }
}
